            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Date"
        },
        "record_id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "settlement_rule": {
          "anyOf": [
            {
              "const": "SETTLED_BEFORE_EX",
              "type": "string"
