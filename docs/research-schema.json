{
  "$defs": {
    "Adjustment": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "pretax_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Pretax Amount"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recurring_test": {
          "const": "GENUINE_ONE_OFF",
          "title": "Recurring Test",
          "type": "string"
        },
        "source_id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "tax_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Tax Effect"
        }
      },
      "required": [
        "description",
        "pretax_amount",
        "tax_effect",
        "rationale",
        "recurring_test",
        "source_id",
        "locator"
      ],
      "title": "Adjustment",
      "type": "object"
    },
