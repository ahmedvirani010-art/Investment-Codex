        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recurring_test": {
          "const": "GENUINE_ONE_OFF",
          "title": "Recurring Test",
          "type": "string"
        },
        "source_id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
