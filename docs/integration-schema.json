    "AlertMethodology": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "ticker": {
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Ticker",
          "type": "string"
        },
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "valid_until": {
          "format": "date",
          "title": "Valid Until",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "methodology_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Methodology Id"
        },
        "approved_replacement": {
          "default": false,
          "title": "Approved Replacement",
          "type": "boolean"
        },
        "bull_score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bull Score"
        },
        "bear_score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bear Score"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "ticker",
        "effective_date",
        "valid_until",
        "source_ids",
        "rationale"
      ],
      "title": "AlertMethodology",
      "type": "object"
    },
